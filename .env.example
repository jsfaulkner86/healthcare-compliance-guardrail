# Healthcare Compliance Guardrail — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# LLM (required)
OPENAI_API_KEY=your_openai_api_key_here

# Database (required for production PostgreSQL audit log)
DATABASE_URL=postgresql://user:password@localhost:5432/guardrail_db

# Guardrail behavior
AUDIT_LOG_ENABLED=true
HIPAA_MODE=true
JCAHO_CHECKPOINT_ENABLED=true

# Optional: use SQLite for local dev (no Postgres required)
# DATABASE_URL=sqlite:///./guardrail_dev.db

# LLM model selection
OPENAI_MODEL=gpt-4o
JCAHO_JUDGE_MODEL=gpt-4o
